# Clerk (existing)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — create project at https://supabase.com/dashboard
# URL: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Service role: Project Settings → API → service_role (server only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: extra disposable domains to block (comma-separated), e.g. temp.example.com,mail.example.org
BLOCKED_EMAIL_DOMAINS=
